# Copie este arquivo para .env e preencha com seus proprios valores
API_FOOTBALL_KEY=coloque_sua_chave_aqui
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

DATABASE_URL=sqlite+aiosqlite:///./betanalyzer.db

# Ciclo principal de coleta: busca TODAS as estatisticas disponiveis de
# cada partida monitorada (de time + de jogador, via 2 requisicoes de API
# por partida a cada ciclo) e grava um MatchSnapshot completo. 3 min por
# pedido explicito de coletar tudo com essa frequencia - de olho na cota
# diaria combinado com MONITORED_LEAGUE_IDS/MAX_MONITORED_FIXTURES abaixo.
COLLECTOR_INTERVAL_MINUTES=3
LIVE_SCAN_INTERVAL_MINUTES=2

# Ciclo curto que so reconsulta as odds ao vivo e recalcula as
# recomendacoes (sem buscar estatisticas novas de novo), pra odd aparecer
# atualizada em todas as telas sem esperar o ciclo completo de 5 min.
# Custa 1 requisicao de odds por partida monitorada a cada execucao - com
# MAX_MONITORED_FIXTURES=8, 2 min em 2 gera ~4x mais chamadas de odds do
# que so o ciclo de coleta. Aumente se sua cota diaria estiver apertada.
ODDS_REFRESH_INTERVAL_MINUTES=2

# Deixe vazio (MONITORED_LEAGUE_IDS=) para monitorar partidas ao vivo de
# QUALQUER liga do mundo. Isso e ótimo pra sempre ter algo pra ver, mas
# gasta cota da API mais rápido (muitas ligas obscuras jogando ao mesmo
# tempo). MAX_MONITORED_FIXTURES abaixo protege contra excesso mesmo
# assim - mas se quiser controlar melhor, use uma lista como a sugerida.
MONITORED_LEAGUE_IDS=

# Trava de seguranca: nunca monitora mais que N partidas ao vivo ao mesmo
# tempo, não importa quantas ligas estejam liberadas acima. Partidas já
# em observação continuam até acabar mesmo acima do limite - ele só
# bloqueia a ENTRADA de partidas novas quando já está cheio. Cada partida
# monitorada custa ~2 requisições por ciclo de coleta (estatísticas de
# time + de jogador, a cada COLLECTOR_INTERVAL_MINUTES) MAIS 1 requisição
# de odds a cada ODDS_REFRESH_INTERVAL_MINUTES - com os padrões atuais
# (3 min e 2 min) e 8 partidas isso já soma bastante requisição por hora.
# Ajuste pra baixo se notar erro de limite excedido na API-Football.
MAX_MONITORED_FIXTURES=8

# Quantas das últimas partidas de cada time usar pra calcular a "forma"
# (média de escanteios, chutes, gols...). 3 ou 5, conforme pedido - 3
# gasta ~40% menos chamadas de API que 5.
TEAM_FORM_SAMPLE_SIZE=3

FRONTEND_ORIGIN=http://localhost:5173
